# kg3d graph service configuration.
# Copy to .env; every value is optional and falls back to the default in app/config.py.

KG3D_DEBUG=false
KG3D_API_PREFIX=/api/v1

# Browser origins allowed to call this service. EMPTY BY DEFAULT: no CORS
# headers are emitted at all, which is correct when the browser reaches the API
# through the same origin as the page (the bundled nginx and Vite configs both
# proxy /api). "*" is honoured for local development but credentials are then
# refused — a wildcard origin plus credentials lets any website make
# authenticated requests on a visitor's behalf.
KG3D_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Shared secret required by the write endpoints (POST /graphs,
# PATCH /graphs/{id}, POST /graphs/{id}/refresh), sent as the X-API-Key header.
# Leave unset only if this service is unreachable from untrusted networks; the
# app logs a warning at every start when it is.
# KG3D_API_KEY=change-me

# Largest graph body accepted by POST /graphs (bytes).
KG3D_MAX_INGEST_BYTES=33554432

# Response ceilings — past these the client should page or use a level of detail.
KG3D_MAX_NODES_PER_RESPONSE=60000
KG3D_MAX_EDGES_PER_RESPONSE=250000

# Analytics / layout cache.
KG3D_CACHE_TTL_SECONDS=900
KG3D_CACHE_MAX_ENTRIES=64

# Above this node count, betweenness and closeness are estimated from sampled
# sources instead of computed exactly. Responses report `approximate: true`.
KG3D_BETWEENNESS_EXACT_THRESHOLD=1200
KG3D_BETWEENNESS_SAMPLES=400

# Server-side layout.
KG3D_LAYOUT_ITERATIONS=200
KG3D_LAYOUT_SCALE=520

# Registered graphs, as JSON.
#
#   sample : synthetic graph, options {size, domains, cross_domain_rate, seed}
#   json   : options {path}
#   sql    : options {dsn, node_query, edge_query}
#   neo4j  : options {uri, user, password, database, node_query, edge_query}
#   memory : populated at runtime via POST /api/v1/graphs
#
KG3D_SOURCES=[{"id":"demo","name":"Sample enterprise graph","kind":"sample","options":{"size":1200,"domains":7,"seed":20260908}}]

# Example: a Postgres-backed graph.
# KG3D_SOURCES=[{"id":"assets","kind":"sql","directed":true,"options":{
#   "dsn":"postgresql+psycopg://user:pass@db:5432/inventory",
#   "node_query":"SELECT id, name AS label, kind AS type, criticality FROM assets",
#   "edge_query":"SELECT src AS source, dst AS target, relation AS type FROM asset_links"}}]
